          <span class="agent-campo-nome">{{localize "CPRX.NcpdTaglia"}}</span>
          <span class="agent-fascicolo-taglia">{{scheda.taglia}} eb</span>
        </div>
        {{/if}}
        {{#if scheda.mandati}}
        <div class="agent-fascicolo-riga">
          <span class="agent-campo-nome">{{localize "CPRX.NcpdMandati"}}</span>
          <span>{{scheda.mandati}}</span>
        </div>
        {{/if}}
        {{#if scheda.precedenti}}
        <div class="agent-fascicolo-riga">
          <span class="agent-campo-nome">{{localize "CPRX.NcpdPrecedenti"}}</span>
