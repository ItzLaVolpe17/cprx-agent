        {{#if ../patchPuoScrivere}}
        <button type="button" class="agent-solo-icona agent-tondo-piccolo acceso"
                data-action="patchPubblica" data-id="{{this.id}}"
                title="{{localize 'CPRX.GardenPubblica'}}">
          <i class="fa-solid fa-paper-plane"></i>
        </button>
        <button type="button" class="agent-solo-icona agent-tondo-piccolo"
                data-action="patchElimina" data-id="{{this.id}}"
                title="{{localize 'CPRX.Elimina'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
        {{/if}}
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/if}}

  {{!-- =========================== INCARICHI ======================== --}}
  {{#if vistaLavori}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      {{#if puoScrivere}}
      <button type="button" class="agent-aggiungi agent-solo-icona" data-action="nuovo"
              title="{{localize 'CPRX.Nuovo'}}"><i class="fa-solid fa-plus"></i></button>
      {{/if}}
    </header>

    <div class="agent-pillole">
      {{#each filtriGig}}
      <button type="button" class="agent-pillola {{#if this.attiva}}attiva{{/if}}"
              data-action="filtroGig" data-filtro="{{this.chiave}}">{{this.etichetta}}</button>
      {{/each}}
    </div>

    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.ElencoVuoto"}}</p>
    {{else}}
    {{!-- Una scheda per lavoro, staccate: qui ogni voce ha quattro righe, e
          attaccarle vorrebbe dire un muro. --}}
    <div class="agent-gig">
      {{#each lavori}}
      <article class="agent-gig-scheda stato-{{this.stato}}">
        <header>
          <span class="agent-tondo-iniziali">{{this.iniziale}}</span>
          <span class="agent-gig-chi">
            <span class="agent-gig-titolo">
              {{this.titolo}}
              {{#if this.daMaster}}<i class="fa-solid fa-tower-broadcast agent-daMaster" title="{{localize 'CPRX.DaMaster'}}"></i>{{/if}}
            </span>
            {{#if this.committente}}<span class="agent-etichetta">{{this.committente}}</span>{{/if}}
          </span>
          <span class="agent-gig-stato">{{this.etichettaStato}}</span>
        </header>

        {{#if this.dettagli}}<p class="agent-gig-testo">{{this.dettagli}}</p>{{/if}}

        <footer>
          <span class="agent-progresso"><i style="width: {{this.avanzamento}}%"></i></span>
          {{#if this.ricompensa}}<span class="agent-gig-paga">{{this.ricompensa}}</span>{{/if}}
        </footer>

        {{#if ../puoScrivere}}
        <div class="agent-gig-azioni">
          <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="modifica"
                  data-id="{{this.id}}" title="{{localize 'CPRX.Apri'}}">
            <i class="fa-solid fa-pen"></i>
          </button>
          <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="elimina"
                  data-id="{{this.id}}" title="{{localize 'CPRX.Elimina'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        {{/if}}
      </article>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if vistaLista}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    <div class="agent-cerca">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="ricerca" value="{{ricerca}}"
             placeholder="{{localize 'CPRX.Cerca'}}" />
    </div>

    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.ElencoVuoto"}}</p>
    {{else}}
    {{!-- Schede staccate, non righe: una nota si legge dall'elenco, e tre
          righe di testo dicono molto piu' di un titolo. --}}
    <div class="agent-note">
      {{#each voci}}
      <article class="agent-nota-scheda">
        <header>
          <span class="agent-nota-titolo">
            {{this.titolo}}
            {{#if this.daMaster}}<i class="fa-solid fa-tower-broadcast agent-daMaster" title="{{localize 'CPRX.DaMaster'}}"></i>{{/if}}
          </span>
          {{#if this.quando}}<span class="agent-etichetta">{{this.quando}}</span>{{/if}}
        </header>
        {{#if this.corpo}}<p class="agent-nota-testo">{{this.corpo}}</p>{{/if}}

        <div class="agent-gig-azioni">
          {{#unless this.coperto}}
          <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="modifica"
                  data-id="{{this.id}}" title="{{localize 'CPRX.Apri'}}">
            <i class="fa-solid fa-pen"></i>
          </button>
          {{/unless}}
          {{#if ../puoScrivere}}
          <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="elimina"
                  data-id="{{this.id}}" title="{{localize 'CPRX.Elimina'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
    {{/if}}

    {{!-- Il tasto per aggiungere sta in fondo, dove finisce la lettura, e
          non e' piu' un piu' in un angolo della testata. --}}
    {{#if puoScrivere}}
    <button type="button" class="agent-tasto-lungo" data-action="nuovo">{{etichettaNuovo}}</button>
    {{/if}}
  </div>
  {{/if}}

  {{#if vistaForm}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="annulla">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3>{{etichettaApp}}</h3>
    </header>

    <div class="agent-modulo">
      {{#each campi}}
      {{#if this.eCheck}}
      <label class="agent-riga agent-interruttore">
        <input type="checkbox" name="{{this.chiave}}" {{#if this.acceso}}checked{{/if}}
               {{#unless ../puoScrivere}}disabled{{/unless}} />
        <span>{{this.etichetta}}</span>
      </label>
      {{else}}
      <label class="agent-campo">
        <span class="agent-campo-nome">{{this.etichetta}}{{#if this.richiesto}} *{{/if}}</span>

        {{#if this.eTesto}}
        <input type="text" name="{{this.chiave}}" value="{{this.valore}}" {{#unless ../puoScrivere}}disabled{{/unless}} />
        {{/if}}
        {{#if this.eNumero}}
        <input type="number" name="{{this.chiave}}" value="{{this.valore}}" {{#unless ../puoScrivere}}disabled{{/unless}} />
        {{/if}}
        {{#if this.eArea}}
        <textarea name="{{this.chiave}}" rows="4" {{#unless ../puoScrivere}}disabled{{/unless}}>{{this.valore}}</textarea>
        {{/if}}
        {{#if this.eSelect}}
        <select name="{{this.chiave}}" {{#unless ../puoScrivere}}disabled{{/unless}}>
          {{#each this.opzioni}}
          <option value="{{this.valore}}" {{#if this.selezionato}}selected{{/if}}>{{this.etichetta}}</option>
          {{/each}}
        </select>
        {{/if}}
      </label>
      {{/if}}
      {{/each}}

      {{#if puoScrivere}}
      <div class="agent-modulo-azioni">
        <button type="button" class="agent-primario" data-action="salva">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "CPRX.Salva"}}
        </button>
        <button type="button" data-action="annulla">{{localize "CPRX.Annulla"}}</button>
      </div>
      {{else}}
      <p class="agent-vuoto">{{localize "CPRX.SolaLettura"}}</p>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{!-- Il dock: quattro tessere fisse sotto lo schermo, come su un telefono.
        Sta fuori dai blocchi delle viste, quindi legge dal contesto comune —
        la stessa regola della barra di stato. --}}
  {{#if dock}}
  <nav class="agent-dock">
    {{#each dock}}
    <button type="button" class="agent-dock-tessera {{#if this.attiva}}attiva{{/if}}"
            data-action="apriApp" data-app="{{this.app}}"
            {{#if this.scheda}}data-scheda="{{this.scheda}}"{{/if}}
            title="{{this.etichetta}}">
      <i class="{{this.icona}}"></i>
      <span>{{this.etichetta}}</span>
      {{#if this.conteggio}}<b class="agent-conta">{{this.conteggio}}</b>{{/if}}
    </button>
    {{/each}}
  </nav>
  {{/if}}

  <span class="agent-barretta" aria-hidden="true"></span>
</div>

  </div>
</div>
