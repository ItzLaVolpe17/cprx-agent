      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    {{!-- Terminale di consultazione, e basta. Il casellario si compila
