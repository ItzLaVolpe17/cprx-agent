    {{/if}}

    {{!-- Il consulto in corso dice a cosa serve, non solo quanto dura:
          un timer da solo non aiuta nessuno al tavolo. --}}
    {{#if consulto}}
    <div class="agent-consulto">
      <div class="agent-consulto-alto">
