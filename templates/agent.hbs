        </div>
        <button type="button" class="agent-solo-icona" data-action="gladiatoreApri"
                title="{{localize 'CPRX.ArenaApriScheda'}}">
          <i class="fa-solid fa-up-right-from-square"></i>
        </button>
      </div>

      <div class="agent-arena-bilancio">
        <div class="agent-cella"><span class="agent-cella-valore">{{bilancio.duelli}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.ArenaDuelli"}}</span></div>
        <div class="agent-cella"><span class="agent-cella-valore">{{bilancio.vinti}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.ArenaVinti"}}</span></div>
        <div class="agent-cella"><span class="agent-cella-valore">{{bilancio.persi}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.ArenaPersi"}}</span></div>
      </div>
      {{else}}
      <p class="agent-vuoto">{{localize "CPRX.GladiatoreMancante"}}</p>
      {{/if}}

      {{#if puoScrivere}}
      <div class="agent-sezione-riga">
        <span class="agent-etichetta">{{localize "CPRX.ArenaScheda"}}</span>
        <span class="agent-filetto"></span>
      </div>
      <div class="agent-riga">
        <select name="gladiatore">
          <option value="">{{localize "CPRX.ArenaNessuno"}}</option>
          {{#each candidati}}
          <option value="{{this.id}}" {{#if this.scelto}}selected{{/if}}>{{this.nome}}</option>
          {{/each}}
        </select>
        <button type="button" class="agent-solo-icona" data-action="gladiatoreScegli"
                title="{{localize 'CPRX.Salva'}}"><i class="fa-solid fa-floppy-disk"></i></button>
      </div>

      {{#if gladiatore}}
      <div class="agent-sezione-riga">
        <span class="agent-etichetta">{{localize "CPRX.SfidaNumero"}}</span>
        <span class="agent-filetto"></span>
      </div>
      <div class="agent-riga">
        <input type="text" name="composto" value="{{composto}}" placeholder="{{localize 'CPRX.Numero'}}" />
      </div>
      <div class="agent-riga">
        <input type="text" name="posta" value="{{posta}}"
               placeholder="{{localize 'CPRX.ArenaPostaNota'}}" />
      </div>

