      <div class="agent-modulo-azioni">
        <button type="button" data-action="sfida" data-modo="amichevole">
          <i class="fa-solid fa-hand-fist"></i> {{localize "CPRX.ArenaAmichevole"}}
        </button>
        <button type="button" class="agent-rosso" data-action="sfida" data-modo="classificata">
          <i class="fa-solid fa-skull"></i> {{localize "CPRX.ArenaClassificata"}}
        </button>
      </div>
      <p class="agent-nota">{{localize "CPRX.ArenaAvviso"}}</p>
      {{/if}}
      {{/if}}

      {{#if haStorico}}
      <div class="agent-sezione-riga">
        <span class="agent-etichetta">{{localize "CPRX.ArenaStorico"}}</span>
        <span class="agent-filetto"></span>
      </div>
      <ul class="agent-elenco">
        {{#each storico}}
        <li class="agent-arena-riga {{#if this.vinto}}vinta{{/if}}">
          <div class="agent-voce-testo">
            <span class="agent-voce-titolo">{{this.avversario}}</span>
            <span class="agent-voce-sotto">{{this.etichettaModo}} · {{this.quando}} · {{this.round}} round</span>
          </div>
          <span class="agent-arena-esito">
            {{#if this.vinto}}{{localize "CPRX.ArenaVinta"}}{{else}}{{localize "CPRX.ArenaPersa"}}{{/if}}
          </span>
        </li>
        {{/each}}
      </ul>
      {{/if}}
    {{/if}}
  </div>
