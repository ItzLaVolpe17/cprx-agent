      <li class="agent-voce">
        <button type="button" class="agent-voce-apri" data-action="schedaApri" data-id="{{this.id}}">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          {{#if this.riga}}<span class="agent-voce-sotto">{{this.riga}}</span>{{/if}}
        </button>
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{/if}}
  </div>
