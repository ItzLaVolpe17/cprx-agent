  {{!-- ============================ TELEFONO ========================= --}}
  {{#if vistaTelefono}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      <span class="agent-saldo">{{numeroMio}}</span>
    </header>

    {{!-- ------------------------- tastierino ------------------------- --}}
    {{!-- Il display e' un campo, non una scritta: il numero si compone col
          tastierino ma si puo' anche scrivere a mano, e il tastierino lo
          rilegge prima di aggiungere una cifra (trappola 11). --}}
    {{#if schedaTastierino}}
    <div class="agent-display">
      <input type="text" name="composto" value="{{composto}}" placeholder="— — —" />
      <span class="agent-display-nota">{{numeroInfo}}</span>
    </div>

    <div class="agent-tastierino">
      {{#each tasti}}
      <button type="button" class="agent-tasto" data-action="cifra" data-cifra="{{this.cifra}}">
        <span class="agent-tasto-cifra">{{this.cifra}}</span>
        <span class="agent-tasto-lettere">{{this.lettere}}</span>
      </button>
      {{/each}}
    </div>

    {{!-- Il verde sta in mezzo, la cancellazione di fianco: il vuoto a
          sinistra serve a tenerlo in centro, non e' un buco. --}}
    <div class="agent-chiama-riga">
      <span class="agent-chiama-vuoto" aria-hidden="true"></span>
      {{#if puoScrivere}}
      <button type="button" class="agent-tondo agent-tondo-verde" data-action="chiama"
              title="{{localize 'CPRX.Chiama'}}" aria-label="{{localize 'CPRX.Chiama'}}">
        <i class="fa-solid fa-phone"></i>
      </button>
      {{/if}}
      <button type="button" class="agent-tondo agent-tondo-nudo" data-action="cancellaCifra"
              title="{{localize 'CPRX.Cancella'}}" aria-label="{{localize 'CPRX.Cancella'}}">
        <i class="fa-solid fa-delete-left"></i>
      </button>
    </div>
    {{/if}}

    {{!-- -------------------------- recenti --------------------------- --}}
    {{#if schedaRecenti}}
    {{#if haRecenti}}
    <ul class="agent-elenco">
      {{#each recenti}}
      <li class="agent-voce {{#if this.persa}}persa{{/if}}">
        <i class="agent-recente-icona {{this.icona}}"></i>
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">
            {{this.quando}}{{#if this.etichettaNumero}} · {{this.etichettaNumero}}{{/if}}
          </span>
        </div>
        {{#unless this.gruppo}}
        <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="apriContatto"
                data-numero="{{this.numero}}" title="{{localize 'CPRX.SchedaContatto'}}">
          <i class="fa-solid fa-circle-info"></i>
        </button>
        {{#if ../puoScrivere}}
        <button type="button" class="agent-solo-icona agent-tondo-piccolo acceso" data-action="chiama"
                data-numero="{{this.numero}}" title="{{localize 'CPRX.Chiama'}}">
          <i class="fa-solid fa-phone"></i>
        </button>
        {{/if}}
        {{/unless}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.NessunaChiamata"}}</p>
    {{/if}}
    {{/if}}

    {{!-- -------------------- contatti e preferiti --------------------
          Una lista sola per due linguette: i preferiti sono contatti
          filtrati, non un'altra cosa. --}}
    {{#if mostraRubrica}}
    {{#if puoScrivere}}
    {{#unless soloPreferiti}}
    <div class="agent-cerca">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="ricerca" value="{{ricerca}}"
             placeholder="{{localize 'CPRX.Cerca'}}" />
    </div>
    {{/unless}}
    {{/if}}

    {{#if haRubrica}}
    <ul class="agent-elenco">
      {{#each rubrica}}
      <li class="agent-voce">
        <span class="agent-tondo-iniziali">{{this.iniziale}}</span>
        <button type="button" class="agent-voce-apri" data-action="apriContatto"
                data-numero="{{this.numero}}">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          {{#if this.sotto}}<span class="agent-voce-sotto">{{this.sotto}}</span>{{/if}}
        </button>
        {{#if this.chiamabile}}
        {{#if ../puoScrivere}}
        <button type="button" class="agent-solo-icona agent-tondo-piccolo acceso" data-action="chiama"
                data-numero="{{this.numero}}" title="{{localize 'CPRX.Chiama'}}">
          <i class="fa-solid fa-phone"></i>
        </button>
        {{/if}}
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="agent-vuoto">{{vuotoRubrica}}</p>
    {{/if}}

    {{#if puoScrivere}}
    {{#unless soloPreferiti}}
    <button type="button" class="agent-cta scarica" data-action="nuovo" data-app="contatti">
      <i class="fa-solid fa-user-plus"></i> {{localize "CPRX.Nuovo"}}
    </button>
    {{/unless}}
    {{/if}}
    {{/if}}

    {{!-- --------------------- scheda di un contatto ------------------- --}}
    {{#if schedaContatto}}
    <div class="agent-contatto">
      <span class="agent-tondo-iniziali grande">{{contatto.iniziale}}</span>
      <span class="agent-contatto-nome">{{contatto.nome}}</span>
      {{#if contatto.sotto}}<span class="agent-etichetta">{{contatto.sotto}}</span>{{/if}}

      <div class="agent-contatto-comandi">
        {{#if puoScrivere}}
        {{!-- Chiamare e scrivere funzionano anche su un numero coperto: il
              collegamento passa da `data-numero`, che non si legge. --}}
        <button type="button" class="agent-comando-tondo" data-action="chiama"
                data-numero="{{contatto.numero}}">
          <span class="agent-comando-cerchio"><i class="fa-solid fa-phone"></i></span>
          <span class="agent-etichetta">{{localize "CPRX.Chiama"}}</span>
        </button>
        <button type="button" class="agent-comando-tondo" data-action="apriConversazione"
                data-numero="{{contatto.numero}}">
          <span class="agent-comando-cerchio secondo"><i class="fa-solid fa-comment-sms"></i></span>
          <span class="agent-etichetta">{{localize "CPRX.Scrivi"}}</span>
        </button>
        {{/if}}
        {{#if contatto.inRubrica}}
        <button type="button" class="agent-comando-tondo" data-action="contattoPreferito"
                data-numero="{{contatto.numero}}">
          <span class="agent-comando-cerchio stella {{#if contatto.preferito}}acceso{{/if}}">
            <i class="fa-solid fa-star"></i>
          </span>
          <span class="agent-etichetta">{{localize "CPRX.Preferito"}}</span>
        </button>
        {{/if}}
      </div>

      {{#if contatto.righe}}
      <ul class="agent-elenco">
        {{#each contatto.righe}}
        <li class="agent-voce">
          <span class="agent-etichetta">{{this.etichetta}}</span>
          <span class="agent-riga-valore">{{this.valore}}</span>
        </li>
        {{/each}}
      </ul>
      {{/if}}

      {{#if contatto.note}}
      <p class="agent-nota">{{contatto.note}}</p>
      {{/if}}

      {{#if contatto.haStorico}}
      <div class="agent-sezione-riga">
        <span class="agent-etichetta">{{localize "CPRX.ContattoCronologia"}}</span>
        <span class="agent-filetto"></span>
      </div>
      <ul class="agent-elenco">
        {{#each contatto.storico}}
        <li class="agent-voce {{#if this.persa}}persa{{/if}}">
          <i class="agent-recente-icona {{this.icona}}"></i>
          <div class="agent-voce-testo">
            <span class="agent-voce-titolo">{{this.etichetta}}</span>
          </div>
          <span class="agent-voce-sotto">{{this.quando}}</span>
        </li>
        {{/each}}
      </ul>
      {{/if}}

      <div class="agent-riga">
        <button type="button" class="agent-cta scarica" data-action="chiudiContatto">
          {{localize "CPRX.Indietro"}}
        </button>
        {{#if puoScrivere}}
        {{#unless contatto.coperto}}
        {{#if contatto.inRubrica}}
        <button type="button" class="agent-cta" data-action="modifica"
                data-app="contatti" data-id="{{contatto.id}}">{{localize "CPRX.Modifica"}}</button>
        {{else}}
        <button type="button" class="agent-cta" data-action="salvaContatto"
                data-numero="{{contatto.numero}}">{{localize "CPRX.SalvaContatto"}}</button>
        {{/if}}
        {{/unless}}
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Le quattro linguette in basso, come su un telefono. --}}
    <nav class="agent-linguette-basso">
      {{#each telefonoSchede}}
      <button type="button" class="agent-linguetta-basso {{#if this.attiva}}attiva{{/if}}"
              data-action="telefonoScheda" data-scheda="{{this.chiave}}">
        <i class="{{this.icona}}"></i>
        <span>{{this.etichetta}}</span>
        {{#if this.conteggio}}<b class="agent-conta">{{this.conteggio}}</b>{{/if}}
      </button>
      {{/each}}
    </nav>
  </div>
  {{/if}}

  {{!-- ======================== DIGITAL GLADIATOR ==================== --}}
