          <div class="agent-gladiatore-stat">
            <span><b>{{gladiatore.ferite}}</b> {{localize "CPRX.ArenaFerite"}}</span>
            <span><b>{{gladiatore.armatura}}</b> {{localize "CPRX.ArenaArmatura"}}</span>
            <span><b>{{gladiatore.ref}}</b> REF</span>
