{{!-- Il corpo del telefono. La finestra di Foundry qui non ha cornice
      (`frame: false`), quindi il manico e il tasto di chiusura sono la
      targhetta qui sopra: senza, la finestra non si sposta e non si chiude.

      Tacca, tasti laterali e barretta sono decorazione dichiarata
      (`aria-hidden`): servono a far sembrare un telefono quello che dentro
      e' gia' un telefono. --}}
<div class="agent-telefono">

  <div class="agent-targhetta" data-manico>
    <i class="fa-solid fa-mobile-screen-button"></i>
    <span class="agent-targhetta-nome">{{nomeAttore}}</span>
    <button type="button" class="agent-targhetta-chiudi" data-action="close"
            title="{{localize 'CPRX.Chiudi'}}" aria-label="{{localize 'CPRX.Chiudi'}}">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <div class="agent-corpo">
    <i class="agent-tasto-lato sinistra alto" aria-hidden="true"></i>
    <i class="agent-tasto-lato sinistra basso" aria-hidden="true"></i>
    <i class="agent-tasto-lato destra" aria-hidden="true"></i>

{{!-- La chiave dell'App sta sulla scocca: da li' il foglio di stile da' a
      ogni App la propria tinta e la propria testata, senza che ogni blocco
      debba marcarsi da solo. --}}
<div class="agent-scocca app-{{appCorrente}}">

  <div class="agent-tacca" aria-hidden="true">
    <i class="agent-tacca-capsula"></i>
    <i class="agent-tacca-occhio"></i>
  </div>

  {{!-- Lo sfondo sta dietro tutto e non intercetta il mouse. Il velo sopra
        non e' decorazione: senza, sulle foto chiare non si legge niente.

        Si vede **solo** sulla home e sul vetro di blocco: dentro un'App
        c'e' un'applicazione a schermo pieno, e una foto sotto un estratto
        conto e' rumore. Il controllo e' qui e non nel CSS perche' diverse
        App si ridisegnano il fondo dello schermo per conto loro, e ognuna
        vincerebbe su una regola generica. --}}
  {{#if sfondoVisibile}}
  <div class="agent-sfondo" aria-hidden="true" style="background-image: url('{{sfondo}}')"></div>
  <div class="agent-sfondo-velo" aria-hidden="true"></div>
  {{/if}}

  {{!-- Righe di scansione: stanno sopra a tutto e non intercettano il mouse. --}}
  <div class="agent-vetro" aria-hidden="true"></div>
  {{#if scanlines}}<div class="agent-spazzata" aria-hidden="true"></div>{{/if}}

  <div class="agent-stato">
    <span class="agent-ora" data-orologio>--:--</span>
    <span class="agent-spia" aria-hidden="true"></span>
    <span class="agent-rete">NET</span>
    <span class="agent-os"></span>
    {{#if gps}}<span class="agent-gps" title="{{localize 'CPRX.TracciamentoGps'}}"><i class="fa-solid fa-location-crosshairs"></i></span>{{/if}}
    <span class="agent-tacche" aria-hidden="true"><i></i><i></i><i></i><i class="spenta"></i></span>
    <span class="agent-batteria" aria-hidden="true"><b></b></span>
  </div>

  {{!-- La chiamata mandata in secondo piano: resta questa striscia, e da qui
        si torna dentro. Sta fuori da ogni vista, quindi legge dal contesto
        comune. --}}
  {{#if chiamataBarra}}
  <button type="button" class="agent-chiamata-striscia" data-action="chiamataApri">
    <i class="fa-solid {{#if chiamataBarra.gruppo}}fa-users{{else}}fa-phone{{/if}}"></i>
    <span class="agent-chiamata-striscia-nome">{{chiamataBarra.nome}}</span>
    <span class="agent-chiamata-striscia-durata" data-durata>{{chiamataBarra.durataTesto}}</span>
  </button>
  {{/if}}

  {{!-- Il saluto sta qui, nell'accensione: nella barra di stato veniva
        troncato dopo tre parole e non lo leggeva nessuno. --}}
  <div class="agent-avvio" aria-hidden="true">
    <span class="agent-avvio-testo">{{bentornato}}</span>
    <span class="agent-avvio-barra"></span>
  </div>

  {{!-- ====================== PRIMA ACCENSIONE ====================== --}}
  {{!-- Un telefono nuovo chiede. Cinque passi, e ogni passo e' un pezzo di
        una schermata che esiste gia' — Impostazioni e Casa — chiesto una
        volta invece che lasciato da cercare.

        I tasti dei temi e degli sfondi sono quelli veri: scrivono subito,
        e qui si mostrano e basta. --}}
  {{#if vistaSetup}}
  <div class="agent-schermo agent-setup">

    <div class="agent-setup-passi" aria-hidden="true">
      {{#each setupPunti}}
      <i class="agent-setup-punto {{#if this.fatto}}fatto{{/if}}"></i>
      {{/each}}
    </div>

    {{#if setupAvvio}}
    <div class="agent-setup-eroe">
      <i class="fa-solid fa-mobile-screen-button"></i>
      <span class="agent-setup-titolo">{{localize "CPRX.SetupTitolo"}}</span>
      <span class="agent-setup-sotto">{{localize "CPRX.SetupSotto"}}</span>
    </div>
    <div class="agent-elenco">
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.Dispositivo"}}</span>
        <span class="agent-riga-valore">{{modello}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.NumeroSerie"}}</span>
        <span class="agent-riga-valore">{{seriale}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.NumeroAgent"}}</span>
        <span class="agent-riga-valore">{{numero}}</span>
      </div>
    </div>
    <p class="agent-nota">{{localize "CPRX.SetupNota"}}</p>
    {{/if}}

    {{#if setupIdentita}}
    <h4 class="agent-sezione">{{localize "CPRX.SetupComeChiamarti"}}</h4>
    <p class="agent-nota">{{localize "CPRX.SetupIdentitaNota"}}</p>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CampoHandle"}}</span>
      <input type="text" name="handle" value="{{handle}}" placeholder="{{nomeAttore}}" />
    </label>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CampoNomeVero"}}</span>
      <input type="text" name="nomeVero" value="{{nomeVero}}" placeholder="{{nomeAttore}}" />
    </label>
    <label class="agent-interruttore">
      <input type="checkbox" name="saluto" {{#unless salutoHandle}}checked{{/unless}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.SalutoColNome"}}</span>
    </label>
    <p class="agent-setup-anteprima">{{salutoAnteprima}}</p>
    {{/if}}

    {{#if setupAspetto}}
    <h4 class="agent-sezione">{{localize "CPRX.Tema"}}</h4>
    <div class="agent-temi">
      {{#each temi}}
      <button type="button" class="agent-tema macchia-{{this.chiave}} {{#if this.attivo}}attivo{{/if}}"
              data-action="scegliTema" data-tema="{{this.chiave}}">
        <span class="agent-tema-macchia"></span>
        <span class="agent-tema-nome">{{this.etichetta}}</span>
      </button>
      {{/each}}
    </div>

    <h4 class="agent-sezione">{{localize "CPRX.Sfondo"}}</h4>
    <div class="agent-sfondi">
      {{#each sfondi}}
      <button type="button" class="agent-sfondo-scelta {{#if this.scelto}}scelto{{/if}} {{#unless this.url}}vuoto{{/unless}}"
              data-action="sfondo" data-sfondo="{{this.chiave}}"
              title="{{this.etichetta}}" aria-label="{{this.etichetta}}"
              {{#if this.url}}style="background-image: url('{{this.url}}')"{{/if}}>
        <span class="agent-sfondo-nome">{{this.etichetta}}</span>
        {{#if this.scelto}}<i class="fa-solid fa-check agent-sfondo-spunta"></i>{{/if}}
      </button>
      {{/each}}
    </div>
    {{/if}}

    {{#if setupCasa}}
    <h4 class="agent-sezione">{{localize "CPRX.SetupDoveVivi"}}</h4>
    {{#if corporativo}}
    <p class="agent-nota agent-abbonato">
      <i class="fa-solid fa-building"></i> {{localize "CPRX.CasaCorporativo"}}
    </p>
    {{else}}
    <p class="agent-nota">{{localize "CPRX.SetupCasaNota"}}</p>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CasaAlloggio"}}</span>
      <select name="alloggio">
        {{#each alloggi}}
        <option value="{{this.chiave}}" {{#if this.scelto}}selected{{/if}}>
          {{this.etichetta}} — {{this.canone}} eb
        </option>
        {{/each}}
      </select>
    </label>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CasaVitto"}}</span>
      <select name="vitto">
        {{#each vitti}}
        <option value="{{this.chiave}}" {{#if this.scelto}}selected{{/if}}>
          {{this.etichetta}} — {{this.costo}} eb
        </option>
        {{/each}}
      </select>
    </label>
    <div class="agent-riga-stato">
      <span class="agent-riga-nome">{{localize "CPRX.CasaCanoneMensile"}}</span>
      <span class="agent-riga-valore">{{totale}} eb</span>
    </div>
    {{/if}}
    {{/if}}

    {{#if setupDispositivo}}
    <h4 class="agent-sezione">{{localize "CPRX.SetupDispositivo"}}</h4>
    <label class="agent-interruttore">
      <input type="checkbox" name="agentInterno" {{#if agentInterno}}checked{{/if}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.AgentInterno"}}</span>
    </label>
    <label class="agent-interruttore">
      <input type="checkbox" name="gps" {{#if gps}}checked{{/if}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.TracciamentoGps"}}</span>
    </label>
    <p class="agent-nota">{{localize "CPRX.SetupDispositivoNota"}}</p>
    {{/if}}

    <div class="agent-setup-fondo">
      {{#unless setupPrimo}}
      <button type="button" class="agent-tasto-lungo" data-action="setupIndietro">
        {{localize "CPRX.Indietro"}}
      </button>
      {{/unless}}
      <button type="button" class="agent-cta" data-action="setupAvanti">
        {{#if setupUltimo}}{{localize "CPRX.SetupAttiva"}}{{else}}{{localize "CPRX.Avanti"}}{{/if}}
      </button>
    </div>
  </div>
  {{/if}}

  {{!-- ======================= SCHERMATA DI BLOCCO =================== --}}
  {{#if vistaBlocco}}
  <div class="agent-schermo agent-blocco-vetro">
    <div class="agent-blocco-ora">
      <span class="agent-orologione" data-orologio>--:--</span>
      <span class="agent-blocco-data">{{dataLunga}}</span>
    </div>

    <div class="agent-blocco-chi">
      <span class="agent-blocco-nome">{{nomeBlocco}}</span>
      <span class="agent-blocco-riga">{{numeroMio}}</span>
    </div>

    {{#if nonLetti}}
    <div class="agent-blocco-avviso">
      <i class="fa-solid fa-comment-sms"></i>
      {{localize "CPRX.MessaggiNonLetti"}} · {{nonLetti}}
    </div>
    {{/if}}

    <button type="button" class="agent-impronta" data-action="sblocca"
            title="{{localize 'CPRX.Sblocca'}}" aria-label="{{localize 'CPRX.Sblocca'}}">
      <i class="fa-solid fa-fingerprint"></i>
    </button>
    <span class="agent-blocco-invito">{{localize "CPRX.Sblocca"}}</span>
  </div>
  {{/if}}

  {{!-- ============================ HOME ============================ --}}
  {{!-- Tre pagine affiancate dentro una pista che scorre in orizzontale.
        Il contenitore non scorre mai in verticale: scorre la pagina. --}}
  {{#if vistaHome}}
  <div class="agent-home">

    <div class="agent-vetrino">
      <div class="agent-pista" data-pista style="transform: {{pista}}">

        {{!-- ---------------------- pagina 0: quadro ---------------------- --}}
        <div class="agent-pagina quadro {{#if paginaQuadro}}attiva{{/if}}">

          <div class="agent-data">{{dataLunga}}</div>
          <div class="agent-orologione" data-orologio>--:--</div>

          <header class="agent-blocco">
            <span class="agent-ritratto-cornice">
              <img class="agent-ritratto" src="{{immagine}}" alt="" />
            </span>
            <div class="agent-blocco-testo">
              <span class="agent-blocco-nome">{{handle}}</span>
              <span class="agent-blocco-vero">{{nomeSotto}}</span>
              <span class="agent-blocco-riga">{{localize "CPRX.DispositivoRegistrato"}}</span>
            </div>
          </header>

          {{!-- Tre cifre e basta: rubrica, lavori aperti, il tuo nome sulla
                strada. Il dispositivo sta nella pagina di sistema. --}}
          <div class="agent-cifre">
            {{#each conteggi}}
            <div class="agent-cifra">
              <span class="agent-cifra-valore">{{this.valore}}</span>
              <span class="agent-etichetta">{{this.etichetta}}</span>
            </div>
            {{/each}}
          </div>

          <div class="agent-sezione-riga">
            <span class="agent-etichetta">{{localize "CPRX.Notifiche"}}</span>
            <span class="agent-filetto"></span>
            {{#if nonLetti}}<span class="agent-etichetta acceso">{{nonLetti}}</span>{{/if}}
          </div>

          {{#if haNotifiche}}
          <ul class="agent-avvisi">
            {{#each notifiche}}
            <li>
              <button type="button" class="agent-avviso genere-{{this.genere}} {{#if this.nuovo}}nuovo{{/if}}"
                      data-action="{{this.azione}}" data-app="{{this.app}}"
                      {{#if this.scheda}}data-scheda="{{this.scheda}}"{{/if}}
                      {{#if this.numero}}data-numero="{{this.numero}}"{{/if}}>
                <span class="agent-avviso-icona"><i class="{{this.icona}}"></i></span>
                <span class="agent-avviso-testo">
                  <span class="agent-avviso-alto">
                    <span class="agent-avviso-titolo">{{this.titolo}}</span>
                    <span class="agent-avviso-ora">{{this.ora}}</span>
                  </span>
                  <span class="agent-avviso-riga">{{this.testo}}</span>
                </span>
              </button>
            </li>
            {{/each}}
          </ul>
          {{else}}
          <p class="agent-vuoto">{{localize "CPRX.NessunaNotifica"}}</p>
          {{/if}}
        </div>

        {{!-- ------------------- pagina 1: applicazioni ------------------- --}}
        <div class="agent-pagina {{#if paginaApp}}attiva{{/if}}" data-pagina-indice="1">
          <div class="agent-sezione-riga">
            <span class="agent-etichetta">{{localize "CPRX.Applicazioni"}}</span>
            <span class="agent-filetto"></span>
            <span class="agent-etichetta">{{quanteApp}}</span>
          </div>

          {{!-- La classe `app-<chiave>` non e' decorativa: da li' la
                mattonella prende la tinta dell'App, dallo stesso blocco che
                la da' alla scocca quando l'App si apre. --}}
          <div class="agent-griglia">
            {{#each app}}
            <button type="button" class="agent-icona app-{{this.chiave}}"
                    data-action="apriApp" data-app="{{this.chiave}}">
              <span class="agent-icona-piastra"><i class="{{this.icona}}"></i></span>
              <span class="agent-icona-nome">{{this.etichetta}}</span>
              {{#if this.conteggio}}<span class="agent-pallino">{{this.conteggio}}</span>{{/if}}
            </button>
            {{/each}}

            {{#each installate}}
            <button type="button" class="agent-icona app-{{this.chiave}}"
                    data-action="apriApp" data-app="{{this.chiave}}">
              <span class="agent-icona-piastra"><i class="{{this.icona}}"></i></span>
              <span class="agent-icona-nome">{{this.etichetta}}</span>
            </button>
            {{/each}}
          </div>
        </div>

        {{!-- ---------------- pagina 2: rete e sistema -------------------- --}}
        <div class="agent-pagina {{#if paginaSistema}}attiva{{/if}}" data-pagina-indice="2">
          <div class="agent-sezione-riga">
            <span class="agent-etichetta">{{localize "CPRX.ReteSistema"}}</span>
            <span class="agent-filetto"></span>
          </div>

          <div class="agent-quadretti">
            <div class="agent-quadretto">
              <span class="agent-etichetta">{{localize "CPRX.NumeroAgent"}}</span>
              <span class="agent-quadretto-valore">{{numeroSistema}}</span>
            </div>
            <div class="agent-quadretto">
              <span class="agent-etichetta">{{localize "CPRX.Archivio"}}</span>
              <span class="agent-quadretto-valore secondo">{{archivio}}</span>
              <span class="agent-barra"><i style="width: {{archivioPercento}}%"></i></span>
              <span class="agent-quadretto-nota">{{localize "CPRX.ArchivioSu"}} {{archivioLimite}}</span>
            </div>
          </div>

          {{!-- Interruttori veri: si premono e cambiano il flag subito. --}}
          <div class="agent-righe">
            <button type="button" class="agent-riga-stato" data-action="commuta" data-flag="agentInterno"
                    {{#unless puoScrivere}}disabled{{/unless}}>
              <span class="agent-riga-nome">{{localize "CPRX.AgentInterno"}}</span>
              <span class="agent-leva {{#if agentInterno}}acceso{{/if}}"></span>
            </button>
            <button type="button" class="agent-riga-stato" data-action="commuta" data-flag="gps"
                    {{#unless puoScrivere}}disabled{{/unless}}>
              <span class="agent-riga-nome">{{localize "CPRX.TracciamentoGps"}}</span>
              <span class="agent-leva {{#if gps}}acceso{{/if}}"></span>
            </button>
            <div class="agent-riga-stato">
              <span class="agent-riga-nome">{{localize "CPRX.MessaggiNonLetti"}}</span>
              <span class="agent-riga-valore">{{nonLetti}}</span>
            </div>
          </div>

          {{!-- Due scorciatoie che su un telefono ci sono sempre: le
                impostazioni per intero, e il blocco. --}}
          <div class="agent-righe">
            <button type="button" class="agent-riga-stato agent-riga-vai"
                    data-action="apriApp" data-app="impostazioni">
              <span class="agent-riga-nome">{{localize "CPRX.Impostazioni"}}</span>
              <i class="fa-solid fa-chevron-right"></i>
            </button>
            <button type="button" class="agent-riga-stato agent-riga-vai" data-action="blocca">
              <span class="agent-riga-nome">{{localize "CPRX.BloccaDispositivo"}}</span>
              <i class="fa-solid fa-chevron-right"></i>
            </button>
          </div>

          <div class="agent-sezione-riga">
            <span class="agent-etichetta">{{localize "CPRX.Dispositivo"}}</span>
            <span class="agent-filetto"></span>
          </div>

          <div class="agent-righe">
            {{#each dispositivo}}
            <div class="agent-riga-stato">
              <span class="agent-riga-nome">{{this.etichetta}}</span>
              <span class="agent-riga-valore">{{this.valore}}</span>
            </div>
            {{/each}}
          </div>

          <div class="agent-sezione-riga">
            <span class="agent-etichetta">{{localize "CPRX.LogDispositivo"}}</span>
            <span class="agent-filetto"></span>
          </div>

          {{#if haRegistro}}
          <div class="agent-registro">
            {{#each registro}}
            <div><span class="{{#if this.allarme}}allarme{{/if}}">{{this.ora}}</span> {{this.testo}}</div>
            {{/each}}
          </div>
          {{else}}
          <p class="agent-vuoto">{{localize "CPRX.LogVuoto"}}</p>
          {{/if}}
        </div>

      </div>
    </div>

    <div class="agent-pallini">
      {{#each pagine}}
      <button type="button" class="agent-pallino-pagina {{#if this.attiva}}attivo{{/if}}"
              data-action="pagina" data-pagina="{{this.indice}}"
              title="{{this.indice}}"><span></span></button>
      {{/each}}
    </div>

    {{!-- La barra che stava qui adesso e' il dock, in fondo alla scocca:
          c'e' in ogni schermata, non solo sulla home. --}}
  </div>
  {{/if}}

  {{!-- ============================= BANCA =========================== --}}
  {{#if vistaBanca}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    {{!-- La carta. Il numero e la scadenza sono cifre di facciata ricavate
          dall'identificativo dell'attore, come il seriale: stabili, e non
          sono un dato che qualcuno debba tenere aggiornato. --}}
    <div class="agent-conto" title="{{eddiesOrigine}}">
      <div class="agent-carta-alto">
        <span class="agent-carta-marca">
          <span class="agent-etichetta acceso">{{localize "CPRX.BancaMarca"}}</span>
          <span class="agent-etichetta">{{localize "CPRX.BancaContoCorrente"}}</span>
        </span>
        <span class="agent-carta-chip" aria-hidden="true"></span>
      </div>

      <span class="agent-etichetta">{{localize "CPRX.BancaSaldo"}}</span>
      <div class="agent-conto-riga-cifra">
        <span class="agent-conto-cifra">{{eddies}}</span>
        <span class="agent-conto-valuta">€$</span>
      </div>

      <div class="agent-carta-basso">
        <span class="agent-carta-numero">{{numeroCarta}}</span>
        <span class="agent-carta-scadenza">
          <span class="agent-etichetta">{{localize "CPRX.BancaScadenza"}}</span>
          <span class="agent-carta-data">{{scadenzaCarta}}</span>
        </span>
      </div>
    </div>

    {{!-- Quattro tasti, e nessuno e' finto: aprono un pannello. --}}
    <div class="agent-conto-tasti">
      <button type="button" class="agent-conto-tasto {{#if bancaInvio}}attivo{{/if}}"
              data-action="bancaPannello" data-pannello="invia"
              {{#unless puoScrivere}}disabled{{/unless}}>
        <i class="fa-solid fa-arrow-up"></i>
        <span>{{localize "CPRX.BancaInvia"}}</span>
      </button>
      <button type="button" class="agent-conto-tasto {{#if bancaRichiesta}}attivo{{/if}}"
              data-action="bancaPannello" data-pannello="richiedi"
              {{#unless puoScrivere}}disabled{{/unless}}>
        <i class="fa-solid fa-arrow-down"></i>
        <span>{{localize "CPRX.BancaRichiedi"}}</span>
      </button>
      <button type="button" class="agent-conto-tasto {{#if bancaCarta}}attivo{{/if}}"
              data-action="bancaPannello" data-pannello="carta">
        <i class="fa-solid fa-credit-card"></i>
        <span>{{localize "CPRX.BancaCarta"}}</span>
      </button>
      <button type="button" class="agent-conto-tasto" data-action="apriApp"
              data-app="telefono" data-scheda="tastierino">
        <i class="fa-solid fa-qrcode"></i>
        <span>{{localize "CPRX.BancaComponi"}}</span>
      </button>
    </div>

    {{#if bancaInvio}}
    <div class="agent-modulo">
      <div class="agent-riga">
        <input type="text" name="bersaglio" value="{{bersaglio}}"
               placeholder="{{localize 'CPRX.Numero'}}" />
        <input type="number" name="importo" min="1" step="1" placeholder="0" />
      </div>
      <input type="text" name="causale" placeholder="{{localize 'CPRX.BancaCausale'}}" />
      <button type="button" class="agent-cta" data-action="bancaInvia">
        {{localize "CPRX.BancaBonifico"}}
      </button>
    </div>
    {{/if}}

    {{#if bancaRichiesta}}
    <div class="agent-modulo">
      <div class="agent-riga">
        <input type="text" name="bersaglio" value="{{bersaglio}}"
               placeholder="{{localize 'CPRX.Numero'}}" />
        <input type="number" name="importo" min="1" step="1" placeholder="0" />
      </div>
      <input type="text" name="causale" placeholder="{{localize 'CPRX.BancaCausale'}}" />
      <button type="button" class="agent-cta" data-action="bancaRichiedi">
        {{localize "CPRX.BancaRichiedi"}}
      </button>
      <p class="agent-nota">{{localize "CPRX.BancaRichiestaNota"}}</p>
    </div>
    {{/if}}

    {{#if bancaCarta}}
    <div class="agent-righe">
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.BancaIntestatario"}}</span>
        <span class="agent-riga-valore">{{intestatario}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.NumeroAgent"}}</span>
        <span class="agent-riga-valore">{{numeroMio}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.NumeroSerie"}}</span>
        <span class="agent-riga-valore">{{seriale}}</span>
      </div>
    </div>
    {{/if}}

    {{!-- Il flusso della settimana: entrate sopra, uscite sotto, e la scala
          e' il giorno piu' grosso — con un solo movimento la prima colonna
          riempirebbe il grafico. --}}
    <div class="agent-flusso">
      <div class="agent-flusso-alto">
        <span class="agent-etichetta">{{localize "CPRX.BancaFlusso"}}</span>
        <span class="agent-flusso-netto">{{nettoSettimana}}</span>
      </div>
      <div class="agent-flusso-colonne">
        {{#each settimana}}
        <div class="agent-flusso-colonna">
          <i class="dentro" style="height: {{this.dentro}}%"></i>
          <i class="fuori" style="height: {{this.fuori}}%"></i>
          <span class="agent-etichetta">{{this.etichetta}}</span>
        </div>
        {{/each}}
      </div>
      <div class="agent-flusso-legenda">
        <span><i class="dentro"></i>{{localize "CPRX.FiltroEntrate"}}</span>
        <span><i class="fuori"></i>{{localize "CPRX.FiltroUscite"}}</span>
      </div>
    </div>

    <div class="agent-quadretti">
      <div class="agent-quadretto">
        <span class="agent-etichetta">{{localize "CPRX.BancaEntrate30"}}</span>
        <span class="agent-quadretto-valore secondo">+{{entrateMese}}</span>
      </div>
      <div class="agent-quadretto">
        <span class="agent-etichetta">{{localize "CPRX.BancaUscite30"}}</span>
        <span class="agent-quadretto-valore critico">−{{usciteMese}}</span>
      </div>
    </div>

    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.BancaMovimenti"}}</span>
      <span class="agent-filetto"></span>
    </div>

    <div class="agent-pillole">
      {{#each filtriBanca}}
      <button type="button" class="agent-pillola {{#if this.attiva}}attiva{{/if}}"
              data-action="filtroBanca" data-filtro="{{this.chiave}}">{{this.etichetta}}</button>
      {{/each}}
    </div>

    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.BancaVuota"}}</p>
    {{else}}
    {{#each giorni}}
    <div class="agent-giornata">
      <div class="agent-giornata-alto">
        <span class="agent-etichetta">{{this.giorno}}</span>
        <span class="agent-giornata-saldo {{#unless this.positivo}}uscita{{/unless}}">{{this.saldoTesto}}</span>
      </div>
      <ul class="agent-elenco">
        {{#each this.righe}}
        <li class="agent-movimento {{#if this.entrata}}entrata{{/if}}">
          <span class="agent-movimento-segno"><i class="{{this.segno}}"></i></span>
          <div class="agent-voce-testo">
            <span class="agent-voce-titolo">{{this.causale}}</span>
            <span class="agent-voce-sotto">{{this.ora}}{{#if this.controparte}} · {{this.controparte}}{{/if}}</span>
          </div>
          <span class="agent-movimento-cifra">{{this.importo}}</span>
        </li>
        {{/each}}
      </ul>
    </div>
    {{/each}}
    {{/if}}
  </div>
  {{/if}}

  {{!-- ============================= CASA ============================ --}}
  {{#if vistaCasa}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      {{#if eddiesNoti}}<span class="agent-saldo">{{eddies}} eb</span>{{/if}}
    </header>

    {{!-- La scheda d'apertura: dove vivi e quanto costa il mese. Le tre
          celle sotto scompongono la cifra grande, e quando una miglioria
          sconta qualcosa lo dice: un totale che non torna con le righe che
          lo compongono e' un totale che nessuno crede. --}}
    <div class="agent-conto">
      <div class="agent-conto-alto">
        <span class="agent-etichetta">{{localize "CPRX.CasaCanoneMensile"}}</span>
        <span class="agent-conto-numero-riga">{{etichettaAlloggio}}</span>
      </div>
      <div class="agent-conto-cifra">{{totale}}</div>

      <div class="agent-celle">
        <div class="agent-cella">
          <span class="agent-cella-valore">{{canone}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CasaAffitto"}}</span>
        </div>
        <div class="agent-cella">
          <span class="agent-cella-valore">{{cibo}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CasaVitto"}}</span>
        </div>
        <div class="agent-cella">
          <span class="agent-cella-valore">{{arretrati}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CasaArretrati"}}</span>
        </div>
      </div>

      {{#if haSconto}}
      <p class="agent-nota agent-abbonato">
        <i class="fa-solid fa-screwdriver-wrench"></i>
        {{localize "CPRX.CasaScontoQg"}} · −{{sconto}} eb
      </p>
      {{/if}}
    </div>

    {{#if corporativo}}
    <p class="agent-nota agent-abbonato">
      <i class="fa-solid fa-building"></i> {{localize "CPRX.CasaCorporativo"}}
    </p>
    {{/if}}

    {{#if haArretrati}}
    <p class="agent-nota agent-arena-avviso">{{localize "CPRX.CasaInMora"}}</p>
    {{/if}}

    {{!-- Il canone puo' non scattare col calendario: se il tavolo ha spento
          l'automatismo va detto, altrimenti uno aspetta un addebito che non
          arrivera' mai. --}}
    {{#unless mesiAuto}}
    <p class="agent-nota">{{localize "CPRX.CasaCanoneAMano"}}</p>
    {{/unless}}

    <div class="agent-righe">
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.CasaUltimoPagamento"}}</span>
        <span class="agent-riga-valore">{{ultimoTesto}}</span>
      </div>
    </div>

    {{!-- Alloggio e vitto sono pillole e non due menu a tendina: sono
          quattro voci per uno, e una tendina per quattro voci nasconde la
          scelta dietro un clic in piu'. Si salvano premendole. --}}
    {{#unless corporativo}}
    {{#if puoScrivere}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CasaAlloggio"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-pillole">
      {{#each alloggi}}
      <button type="button" class="agent-pillola {{#if this.scelto}}attiva{{/if}}"
              data-action="casaScegli" data-campo="alloggio" data-valore="{{this.chiave}}">
        {{this.etichetta}} · {{this.canone}}
      </button>
      {{/each}}
    </div>

    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CasaVitto"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-pillole">
      {{#each vitti}}
      <button type="button" class="agent-pillola {{#if this.scelto}}attiva{{/if}}"
              data-action="casaScegli" data-campo="vitto" data-valore="{{this.chiave}}">
        {{this.etichetta}} · {{this.costo}}
      </button>
      {{/each}}
    </div>
    {{/if}}

    {{#if puoPagare}}
    <button type="button" class="agent-cta" data-action="casaPaga">
      {{localize "CPRX.CasaPaga"}} {{totale}} eb
    </button>
    {{/if}}
    {{/unless}}

    {{!-- Il Quartier Generale. I Punti Miglioria li assegna il master dalla
          console: sono quello che la squadra si e' costruita, non una cosa
          che si compra col portafogli. --}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.QgTitolo"}} · {{pmqg}} PMQG</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-elenco">
      {{#each migliorieVoci}}
      <button type="button" class="agent-voce agent-qg-riga {{#if this.attiva}}costruita{{/if}}"
              data-action="casaMiglioria" data-miglioria="{{this.chiave}}"
              {{#unless ../puoScrivere}}disabled{{/unless}}>
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">{{this.nota}}</span>
        </span>
        <span class="agent-marchietto">
          {{#if this.attiva}}{{localize "CPRX.QgAttiva"}}{{else}}{{this.costo}} PMQG{{/if}}
        </span>
      </button>
      {{/each}}
    </div>

    {{#if haStorico}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CasaStorico"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-elenco">
      {{#each storico}}
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{this.quando}} · {{this.controparte}}</span>
        <span class="agent-riga-valore">{{this.importo}} eb</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if puoScrivere}}
    <p class="agent-nota">{{localize "CPRX.CasaNota"}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================== CORP LINK ========================== --}}
  {{!-- Il portale dipendenti. **Qui dentro non si scrive niente**: la
        Corporazione e il livello del badge li assegna il master dalla
        console, avvisi, accessi e incarichi stanno nell'archivio aziendale.
        L'unica linguetta che non legge l'archivio e' quella dei benefit,
        che si ricavano da dove stanno gia'. --}}
  {{#if vistaCorp}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    {{#if corpSenzaBadge}}
    {{!-- Nessun badge: non c'e' niente da mostrare e niente da fare. Il
          master legge dove si assegna, il giocatore legge che non e' cosa
          sua. --}}
    <div class="agent-eroe agent-corp-badge">
      <div class="agent-corp-testa">
        <span class="agent-corp-glifo grande">?</span>
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{localize "CPRX.CorpSenzaBadge"}}</span>
          <span class="agent-voce-sotto">{{localize "CPRX.CorpSenzaBadgeNota"}}</span>
        </span>
      </div>
    </div>
    {{#if eGm}}
    <p class="agent-nota">{{localize "CPRX.CorpAssegnaDaConsole"}}</p>
    {{/if}}
    {{else}}

    {{!-- Il badge. La tinta la porta la Corporazione, non il tema: due
          dipendenti di due aziende diverse non hanno la stessa tessera. --}}
    <div class="agent-eroe agent-corp-badge" style="--corp-tinta: {{corp.colore}}">
      <div class="agent-corp-testa">
        <span class="agent-corp-glifo grande">{{corp.glifo}}</span>
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{corp.nome}}</span>
          <span class="agent-voce-sotto">{{corp.settore}}</span>
        </span>
      </div>
      <div class="agent-celle">
        <div class="agent-cella">
          <span class="agent-cella-valore">{{corp.livello}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CorpLivello"}}</span>
        </div>
        <div class="agent-cella">
          <span class="agent-cella-valore">{{corp.badge}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CorpBadge"}}</span>
        </div>
        <div class="agent-cella">
          <span class="agent-cella-valore {{#unless corp.attivo}}agent-corp-sospeso{{/unless}}">{{corpStato}}</span>
          <span class="agent-cella-nome">{{localize "CPRX.CorpAccesso"}}</span>
        </div>
      </div>
    </div>

    <div class="agent-pillole">
      {{#each corpSchede}}
      <button type="button" class="agent-pillola {{#if this.attiva}}attiva{{/if}}"
              data-action="corpScheda" data-scheda="{{this.chiave}}">{{this.etichetta}}</button>
      {{/each}}
    </div>

    {{#if corpBachecaAperta}}
    {{#if haAvvisi}}
    <div class="agent-elenco">
      {{#each avvisi}}
      <div class="agent-voce agent-corp-avviso">
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.titolo}}</span>
          <span class="agent-voce-sotto">{{this.testo}}</span>
          <span class="agent-etichetta">{{this.quando}}</span>
        </span>
        {{#if this.tag}}<span class="agent-marchietto">{{this.tag}}</span>{{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.CorpBachecaVuota"}}</p>
    {{/if}}
    {{/if}}

    {{#if corpAccessiAperta}}
    <div class="agent-elenco">
      {{#each accessi}}
      <div class="agent-voce agent-corp-accesso {{#if this.aperto}}aperto{{else}}chiuso{{/if}}">
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">{{this.nota}}</span>
        </span>
        <span class="agent-marchietto">
          {{localize "CPRX.CorpLivello"}} {{this.livello}} ·
          {{#if this.aperto}}{{localize "CPRX.CorpAperto"}}{{else}}{{localize "CPRX.CorpChiuso"}}{{/if}}
        </span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- Gli incarichi li mette l'azienda, come gli avvisi: qui si leggono
          e basta. Chi li vuole seguire se li segna nella sua App Incarichi,
          che e' un'altra cosa e sta sul suo telefono. --}}
    {{#if corpIncarichiAperta}}
    {{#if haIncarichi}}
    <div class="agent-elenco">
      {{#each incarichi}}
      <div class="agent-voce agent-corp-incarico">
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.titolo}}</span>
          <span class="agent-voce-sotto">{{this.testo}}</span>
          {{#if this.tag}}<span class="agent-etichetta">{{this.tag}}</span>{{/if}}
        </span>
        {{#if this.importo}}<span class="agent-voce-cifra">{{this.importo}} eb</span>{{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.CorpIncarichiVuoti"}}</p>
    {{/if}}
    {{/if}}

    {{#if corpBenefitAperta}}
    <div class="agent-elenco">
      {{#each benefit}}
      <div class="agent-voce agent-corp-benefit {{#if this.attivo}}attivo{{/if}}">
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">{{this.nota}}</span>
        </span>
        <span class="agent-marchietto">
          {{#if this.attivo}}{{localize "CPRX.CorpIncluso"}}{{else}}{{localize "CPRX.CorpNonIncluso"}}{{/if}}
        </span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if corpHaScheda}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CorpScheda"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-elenco">
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.CorpQg"}}</span>
        <span class="agent-riga-valore">{{corp.qg}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.CorpDirigente"}}</span>
        <span class="agent-riga-valore">{{corp.dirigente}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.CorpImpiegati"}}</span>
        <span class="agent-riga-valore">{{corp.impiegati}}</span>
      </div>
      <div class="agent-riga-stato">
        <span class="agent-riga-nome">{{localize "CPRX.CorpUffici"}}</span>
        <span class="agent-riga-valore">{{corp.uffici}}</span>
      </div>
    </div>
    <p class="agent-nota">{{corp.note}}</p>
    {{/if}}

    <p class="agent-nota">{{localize "CPRX.CorpTracciato"}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================= REPUTAZIONE ========================= --}}
  {{#if vistaReputazione}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    {{#if repNota}}
    <div class="agent-conto">
      <div class="agent-conto-alto">
        <span class="agent-etichetta">{{localize "CPRX.RepTuoNome"}}</span>
        <span class="agent-conto-numero-riga">{{repLivello}}</span>
      </div>
      <div class="agent-conto-cifra">{{repValore}}</div>
      <p class="agent-nota{{#if repPubblica}} agent-abbonato{{/if}}">
        <i class="fa-solid fa-tower-broadcast"></i> {{repPortata}}
      </p>
    </div>

    {{!-- La scala: dove sei e quanto manca al gradino dopo. --}}
    <div class="agent-rep-scala">
      {{#each repScala}}
      <div class="agent-rep-gradino{{#if this.qui}} qui{{/if}}">
        <span class="agent-rep-soglia">{{this.da}}+</span>
        <span class="agent-rep-nome">{{this.etichetta}}</span>
      </div>
      {{/each}}
    </div>

    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.RepRegistro"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <p class="agent-nota">{{localize "CPRX.RepRegistroNota"}}</p>

    {{#if repHaRegistro}}
    <ul class="agent-elenco">
      {{#each repRegistro}}
      <li class="agent-voce">
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.testo}}</span>
          {{#if this.motivo}}<span class="agent-voce-sotto">{{this.motivo}}</span>{{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.RepRegistroVuoto"}}</p>
    {{/if}}

    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.RepNonLetta"}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================== CALENDARIO ========================= --}}
  {{#if vistaCalendario}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    <div class="agent-cal-oggi">
      <span class="agent-cal-oggi-data">{{oggiLungo}}</span>
      <span class="agent-cal-oggi-ora">{{oggiOra}}</span>
      <span class="agent-cal-oggi-sett">
        {{localize "CPRX.CalSettimana"}} {{settimanaNumero}}
      </span>
    </div>

    {{!-- La griglia del mese. Le celle sono bottoni: toccarne una apre il
          suo giorno qui sotto. --}}
    <div class="agent-cal-barra">
      <button type="button" class="agent-solo-icona" data-action="calMese"
              data-mese="{{precedente}}" title="{{localize 'CPRX.CalPrecedente'}}">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <span class="agent-cal-mese">{{intestazioneMese}}</span>
      <button type="button" class="agent-solo-icona" data-action="calMese"
              data-mese="{{seguente}}" title="{{localize 'CPRX.CalSeguente'}}">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <div class="agent-cal-griglia">
      {{#each iniziali}}
      <span class="agent-cal-iniziale" aria-hidden="true">{{this}}</span>
      {{/each}}

      {{#each celle}}
      {{#if this.fuori}}
      <span class="agent-cal-cella fuori">{{this.numero}}</span>
      {{else}}
      <button type="button" data-action="calGiorno" data-giorno="{{this.chiave}}"
              class="agent-cal-cella{{#if this.oggi}} oggi{{/if}}{{#if this.scelto}} scelto{{/if}}">
        {{this.numero}}
        {{#if this.punto}}<span class="agent-cal-punto"></span>{{/if}}
      </button>
      {{/if}}
      {{/each}}
    </div>

    {{#if tornaOggi}}
    <button type="button" class="agent-conferma" data-action="calMese" data-mese="0">
      <i class="fa-solid fa-rotate-left"></i> {{localize "CPRX.CalTornaOggi"}}
    </button>
    {{/if}}

    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{giornoLungo}}</span>
      <span class="agent-filetto"></span>
    </div>

    {{#if haEventi}}
    <ul class="agent-elenco">
      {{#each eventi}}
      <li class="agent-voce">
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.titolo}}</span>
          {{#if this.testo}}<span class="agent-voce-sotto">{{this.testo}}</span>{{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.CalNienteQuelGiorno"}}</p>
    {{/if}}

    {{#if haProssimi}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CalInProgramma"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <ul class="agent-elenco">
      {{#each prossimi}}
      <li class="agent-voce">
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.titolo}}</span>
          <span class="agent-voce-sotto">
            {{#if this.oggi}}{{localize "CPRX.CalOggi"}}{{else}}{{this.quando}}{{/if}}
          </span>
        </div>
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{!-- Le scadenze: quello che ti verra' addebitato, e quando. Non e' un
          elenco archiviato — il canone lo sa Casa, l'abbonamento lo sa
          l'App che ce l'ha, e qui si leggono. --}}
    {{#if haScadenze}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.CalScadenze"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-elenco">
      {{#each scadenze}}
      <div class="agent-voce agent-cal-scadenza">
        <span class="agent-cal-quando">{{this.quando}}</span>
        <span class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.titolo}}</span>
          <span class="agent-voce-sotto">{{this.nota}}</span>
        </span>
        <span class="agent-voce-cifra">{{this.importo}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- ---------------------- downtime ---------------------- --}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">
        {{localize "CPRX.DtTitolo"}} · {{localize "CPRX.CalSettimana"}} {{dtSettimana}}
      </span>
      <span class="agent-filetto"></span>
    </div>

    {{#if dtModulo}}
    <div class="agent-modulo">
      <label class="agent-campo">
        <span class="agent-campo-nome">{{localize "CPRX.DtCosaFai"}}</span>
        <select name="dtAttivita">
          {{#each dtAttivita}}
          <option value="{{this.chiave}}" {{#if this.scelta}}selected{{/if}}>{{this.etichetta}}</option>
          {{/each}}
        </select>
      </label>
      <label class="agent-campo">
        <span class="agent-campo-nome">{{localize "CPRX.DtNota"}}</span>
        <textarea name="dtNota" rows="3" placeholder="{{localize 'CPRX.DtNotaEsempio'}}">{{dtVoce.nota}}</textarea>
      </label>
      <div class="agent-modulo-azioni">
        <button type="button" class="agent-primario" data-action="dtSalva">
          <i class="fa-solid fa-floppy-disk"></i> {{localize "CPRX.Salva"}}
        </button>
        <button type="button" data-action="dtAnnulla">{{localize "CPRX.Annulla"}}</button>
      </div>
    </div>

    {{else if dtVoce}}
    <div class="agent-dt-voce{{#if dtVoce.chiuso}} chiusa{{/if}}">
      <div class="agent-dt-capo">
        <i class="{{dtVoce.icona}}"></i>
        <span class="agent-dt-nome">{{dtVoce.etichetta}}</span>
        <span class="agent-dt-stato">
          {{#if dtVoce.chiuso}}{{localize "CPRX.DtChiusa"}}{{else}}{{localize "CPRX.DtInAttesa"}}{{/if}}
        </span>
      </div>
      {{#if dtVoce.nota}}<p class="agent-dt-nota">{{dtVoce.nota}}</p>{{/if}}
      {{#if dtVoce.esito}}
      <p class="agent-dt-esito"><span>{{localize "CPRX.DtEsito"}}</span> {{dtVoce.esito}}</p>
      {{/if}}
    </div>

    {{#if dtModificabile}}
    {{#if puoScrivere}}
    <div class="agent-modulo-azioni">
      <button type="button" data-action="dtApri">
        <i class="fa-solid fa-pen"></i> {{localize "CPRX.DtCambia"}}
      </button>
      <button type="button" class="agent-rosso" data-action="dtRitira">
        <i class="fa-solid fa-xmark"></i> {{localize "CPRX.DtRitira"}}
      </button>
    </div>
    {{/if}}
    {{/if}}

    {{else}}
    <p class="agent-vuoto">{{localize "CPRX.DtNienteDichiarato"}}</p>
    {{#if puoScrivere}}
    <button type="button" class="agent-primario agent-conferma" data-action="dtApri">
      <i class="fa-solid fa-calendar-check"></i> {{localize "CPRX.DtDichiara"}}
    </button>
    {{/if}}
    {{/if}}

    {{#if dtHaStorico}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.DtPassate"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <ul class="agent-elenco">
      {{#each dtStorico}}
      <li class="agent-voce">
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">
            <i class="{{this.icona}}"></i> {{this.etichetta}}
          </span>
          <span class="agent-voce-sotto">
            {{localize "CPRX.CalSettimana"}} {{this.settimana}}{{#if this.esito}} · {{this.esito}}{{/if}}
          </span>
        </div>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================== APP STORE ========================= --}}
  {{#if vistaAppStore}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      {{#if eddiesNoti}}<span class="agent-saldo">{{eddies}} eb</span>{{/if}}
    </header>

    <div class="agent-cerca">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="ricerca" value="{{ricerca}}"
             placeholder="{{localize 'CPRX.StoreCerca'}}" />
    </div>

    <div class="agent-pillole">
      {{#each fasce}}
      <button type="button" class="agent-pillola {{#if this.attiva}}attiva{{/if}}"
              data-action="fasciaStore" data-fascia="{{this.chiave}}">{{this.etichetta}}</button>
      {{/each}}
    </div>

    {{!-- Una riga per App, dentro una scheda sola: la mattonella colorata a
          sinistra porta la tinta dell'App, e il tasto a destra dice in una
          parola cosa succede se lo premi. --}}
    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.NienteInVetrina"}}</p>
    {{else}}
    <ul class="agent-elenco">
      {{#each catalogo}}
      <li class="agent-voce app-{{this.chiave}}">
        <span class="agent-store-icona"><i class="{{this.icona}}"></i></span>
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">{{this.produttore}} · {{this.disponibilita}}</span>
          <span class="agent-voce-corpo">{{this.descrizione}}</span>
        </div>
        {{#if this.diSerie}}
        <span class="agent-store-serie">{{localize "CPRX.StoreDiSerie"}}</span>
        {{else if this.soloMaster}}
        {{!-- La mette il datore di lavoro, e al tavolo e' il master: in
              catalogo si legge cosa fa, ma il tasto ce l'ha lui. --}}
        <span class="agent-store-serie">{{localize "CPRX.StoreSoloMaster"}}</span>
        {{else if ../puoScrivere}}
        {{#unless this.posseduta}}
        <button type="button" class="agent-pillola agent-store-tasto" data-action="compraApp"
                data-chiave="{{this.chiave}}" {{#if this.troppoCara}}disabled{{/if}}>
          {{#if this.gratuita}}{{localize "CPRX.StoreOttieni"}}{{else}}{{this.prezzo}} eb{{/if}}
        </button>
        {{else}}
          {{#if this.installata}}
          <button type="button" class="agent-pillola agent-store-tasto" data-action="disinstallaApp"
                  data-chiave="{{this.chiave}}">{{localize "CPRX.Disinstalla"}}</button>
          {{else}}
          <button type="button" class="agent-pillola agent-store-tasto attiva" data-action="installaApp"
                  data-chiave="{{this.chiave}}">{{localize "CPRX.Installa"}}</button>
          {{/if}}
        {{/unless}}
        {{else}}
        <span class="agent-articolo-prezzo">{{this.prezzo}} eb</span>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ====================== APP INSTALLATA ======================== --}}
  {{#if vistaInstallata}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    <div class="agent-installata">
      <span class="agent-scheda-icona grande"><i class="{{iconaApp}}"></i></span>
      <span class="agent-blocco-riga">{{produttore}}</span>
      <p class="agent-installata-testo">{{descrizione}}</p>
      {{#if puoScrivere}}
      <button type="button" data-action="disinstallaApp" data-chiave="{{chiaveApp}}">
        <i class="fa-solid fa-trash-can-arrow-up"></i> {{localize "CPRX.Disinstalla"}}
      </button>
      {{/if}}
    </div>
  </div>
  {{/if}}

  {{!-- ========================== AGENT BRUCIATO ===================== --}}
  {{#if vistaDistrutto}}
  <div class="agent-schermo agent-guasto">
    <i class="fa-solid fa-triangle-exclamation agent-guasto-icona"></i>
    <span class="agent-guasto-titolo">{{localize "CPRX.AgentDistrutto"}}</span>
    <p class="agent-installata-testo">{{localize "CPRX.AgentDistruttoTesto"}}</p>

    {{#if eGm}}
    <button type="button" class="agent-primario" data-action="riparaAgent">
      <i class="fa-solid fa-screwdriver-wrench"></i> {{localize "CPRX.RiparaAgent"}}
    </button>
    {{else}}
      {{#if puoScrivere}}
      <button type="button" class="agent-primario" data-action="riparaAgent">
        <i class="fa-solid fa-cart-plus"></i> {{localize "CPRX.SostituisciAgent"}} — {{prezzoAgent}} eb
      </button>
      {{/if}}
    {{/if}}
  </div>
  {{/if}}

  {{!-- ============================ CHIAMATA ========================= --}}
  {{#if vistaChiamata}}
  <div class="agent-schermo agent-chiamata">
    <span class="agent-chiamata-stato">{{chiamata.etichettaStato}}</span>

    <div class="agent-chiamata-tondo" aria-hidden="true">
      {{#if chiamata.gruppo}}<i class="fa-solid fa-users"></i>
      {{else}}<span>{{chiamata.iniziali}}</span>{{/if}}
    </div>

    <span class="agent-chiamata-nome">{{chiamata.nome}}</span>
    <span class="agent-chiamata-numero">{{chiamata.etichettaNumero}}</span>
    <span class="agent-chiamata-durata" data-durata>{{chiamata.durataTesto}}</span>

    {{!-- In un gruppo si vede chi c'e' dentro e chi sta ancora squillando. --}}
    {{#if chiamata.gruppo}}
    <ul class="agent-chiamata-gente">
      {{#each chiamata.partecipanti}}
      <li class="{{#if this.inLinea}}in-linea{{/if}}">
        <i class="fa-solid {{#if this.inLinea}}fa-phone{{else}}fa-signal{{/if}}"></i>
        <span>{{this.nome}}</span>
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if invito}}
    <div class="agent-chiamata-invito">
      {{#if haInvitabili}}
      <ul class="agent-elenco agent-scelte">
        {{#each invitabili}}
        <li class="agent-voce">
          <label class="agent-scelta">
            <input type="checkbox" name="invita-{{this.numero}}" />
            <span class="agent-voce-titolo">{{this.nome}}</span>
          </label>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      <div class="agent-riga">
        <input type="text" name="invitaNumeri" placeholder="{{localize 'CPRX.GruppoAltriNumeri'}}" />
        <button type="button" class="agent-primario agent-solo-icona" data-action="chiamataInvita"
                title="{{localize 'CPRX.ChiamataInvita'}}"><i class="fa-solid fa-user-plus"></i></button>
      </div>
    </div>
    {{/if}}

    {{!-- I comandi secondari stanno in una griglia sopra il tasto rosso,
          come nel progetto di design. Sono **solo quelli veri**: muto,
          vivavoce e registrazione qui non esisterebbero, e un tasto che non
          fa niente e' peggio di un tasto che manca. --}}
    {{#if puoAggiungere}}
    <div class="agent-chiamata-comandi">
      <button type="button" class="agent-chiamata-comando" data-action="chiamataAggiungi">
        <i class="fa-solid fa-user-plus"></i>
        <span>{{localize "CPRX.ChiamataAggiungi"}}</span>
      </button>
      <button type="button" class="agent-chiamata-comando" data-action="chiamataSfondo">
        <i class="fa-solid fa-down-left-and-up-right-to-center"></i>
        <span>{{localize "CPRX.ChiamataSfondo"}}</span>
      </button>
    </div>
    {{/if}}

    <div class="agent-chiamata-tasti">
      {{#if chiamata.daRispondere}}
      <button type="button" class="agent-tondo agent-tondo-verde" data-action="rispondiChiamata"
              title="{{localize 'CPRX.Rispondi'}}" aria-label="{{localize 'CPRX.Rispondi'}}">
        <i class="fa-solid fa-phone"></i>
      </button>
      {{/if}}
      <button type="button" class="agent-tondo agent-tondo-rosso" data-action="chiudiChiamata"
              title="{{chiamata.etichettaChiudi}}" aria-label="{{chiamata.etichettaChiudi}}">
        <i class="fa-solid fa-phone-slash"></i>
      </button>
    </div>
  </div>
  {{/if}}

  {{!-- ============================ MESSAGGI ========================= --}}
  {{#if vistaMessaggi}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      <span class="agent-saldo">{{numeroMio}}</span>
    </header>

    <div class="agent-cerca">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="ricerca" value="{{ricerca}}"
             placeholder="{{localize 'CPRX.Cerca'}}" />
    </div>

    <div class="agent-pillole">
      {{#each filtriMsg}}
      <button type="button" class="agent-pillola {{#if this.attiva}}attiva{{/if}}"
              data-action="filtroMsg" data-filtro="{{this.chiave}}">{{this.etichetta}}</button>
      {{/each}}
    </div>

    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.NessunaConversazione"}}</p>
    {{else}}
    {{!-- Il non letto e' un punto, non un contatore: quante righe non hai
          letto non cambia niente, che ce ne siano lo cambia. --}}
    <ul class="agent-elenco">
      {{#each conversazioni}}
      <li class="agent-voce agent-filo-riga {{#if this.nonLetti}}nuovo{{/if}} {{#if this.gruppo}}di-gruppo{{/if}}">
        <span class="agent-tondo-iniziali">
          {{#if this.gruppo}}<i class="fa-solid fa-users"></i>
          {{else if this.senzaNome}}<i class="fa-solid fa-user"></i>
          {{else}}{{this.iniziale}}{{/if}}
        </span>
        <button type="button" class="agent-voce-apri" data-action="apriConversazione"
                data-numero="{{this.numero}}">
          <span class="agent-filo-testata">
            <span class="agent-voce-titolo">{{this.nome}}</span>
            <span class="agent-filo-quando">{{this.quando}}</span>
          </span>
          <span class="agent-filo-coda">
            <span class="agent-voce-sotto">{{this.anteprima}}</span>
            {{#if this.nonLetti}}<i class="agent-punto"></i>{{/if}}
          </span>
        </button>
        {{#if ../puoScrivere}}
        <div class="agent-voce-azioni">
          <button type="button" class="agent-solo-icona" data-action="cancellaChat"
                  data-numero="{{this.numero}}" title="{{localize 'CPRX.CancellaChat'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
        {{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{!-- Aprire un filo nuovo sta in fondo, non in cima: la cosa che si fa
          entrando nei messaggi e' leggere quelli che ci sono. Il numero si
          scrive quando serve — di solito si scrive a chi ti ha gia' scritto,
          e il campo sempre aperto era una riga di modulo in mezzo a un
          elenco. --}}
    {{#if puoScrivere}}
    {{#if compositore}}
    <div class="agent-riga">
      <input type="text" name="composto" value="" placeholder="{{localize 'CPRX.NuovoNumero'}}" />
      <button type="button" class="agent-solo-icona" data-action="apriConversazione"
              title="{{localize 'CPRX.Scrivi'}}"><i class="fa-solid fa-pen-to-square"></i></button>
      <button type="button" class="agent-solo-icona" data-action="gruppoNuovo"
              title="{{localize 'CPRX.GruppoNuovo'}}"><i class="fa-solid fa-users"></i></button>
    </div>
    {{/if}}
    <button type="button" class="agent-tasto-lungo {{#if compositore}}attivo{{/if}}"
            data-action="compositore">
      {{#if compositore}}{{localize "CPRX.Annulla"}}{{else}}{{localize "CPRX.NuovoMessaggio"}}{{/if}}
    </button>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================== CONVERSAZIONE ====================== --}}
  {{#if vistaConversazione}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="apriApp" data-app="messaggi">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      {{#if puoScrivere}}
      {{!-- In un gruppo non c'e' un numero da chiamare ne' da salvare in
            rubrica: si esce, e basta. --}}
      {{#if gruppo}}
      <button type="button" class="agent-solo-icona" data-action="gruppoChiama"
              title="{{localize 'CPRX.GruppoChiama'}}">
        <i class="fa-solid fa-phone"></i>
      </button>
      <button type="button" class="agent-solo-icona" data-action="gruppoEsci"
              title="{{localize 'CPRX.GruppoEsci'}}">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
      </button>
      {{else}}
      <button type="button" class="agent-solo-icona" data-action="chiama" data-numero="{{numeroAltro}}"
              title="{{localize 'CPRX.Chiama'}}"><i class="fa-solid fa-phone"></i></button>
      {{!-- Un numero coperto non si salva: in rubrica ci finirebbe scritto. --}}
      {{#unless coperto}}
      {{#unless inRubrica}}
      <button type="button" class="agent-solo-icona" data-action="salvaContatto" data-numero="{{numeroAltro}}"
              title="{{localize 'CPRX.SalvaContatto'}}"><i class="fa-solid fa-user-plus"></i></button>
      {{/unless}}
      {{/unless}}
      {{/if}}
      <button type="button" class="agent-solo-icona" data-action="cancellaChat"
              data-numero="{{chiaveFilo}}" title="{{localize 'CPRX.CancellaChat'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
      {{/if}}
    </header>

    {{#if gruppo}}
    <p class="agent-gruppo-membri">
      <i class="fa-solid fa-users"></i>
      <span>{{membriTesto}}</span>
    </p>
    {{/if}}

    {{#if coperto}}
    <p class="agent-vuoto">{{localize "CPRX.ConversazioneCoperta"}}</p>
    {{/if}}

    {{#unless raggiungibile}}
    <p class="agent-vuoto">{{localize "CPRX.NumeroSpento"}}</p>
    {{/unless}}

    <ul class="agent-filo">
      {{#each voci}}
      <li class="agent-bolla {{#if this.uscente}}mia{{/if}} {{#if this.chiamata}}squillo{{/if}}">
        {{#if this.mittente}}
        <span class="agent-bolla-mittente">{{this.mittente}}</span>
        {{/if}}
        {{#if this.immagine}}
        <img class="agent-bolla-immagine" src="{{this.immagine}}" alt="" />
        {{/if}}
        {{#if this.testo}}<span class="agent-bolla-testo">{{this.testo}}</span>{{/if}}
        <span class="agent-bolla-ora">{{this.ora}}</span>
      </li>
      {{/each}}
    </ul>

    {{#if puoScrivere}}
    <div class="agent-scrivi">
      <textarea name="testo" rows="2" placeholder="{{localize 'CPRX.ScriviMessaggio'}}"></textarea>
      <button type="button" class="agent-primario agent-solo-icona" data-action="inviaSms"
              title="{{localize 'CPRX.Invia'}}"><i class="fa-solid fa-paper-plane"></i></button>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================== NUOVO GRUPPO ======================= --}}
  {{#if vistaNuovoGruppo}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="gruppoAnnulla">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    <label class="agent-campo">
