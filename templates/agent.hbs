    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.MedscanPer"}}</span>
      <input type="text" name="perNumero" value="" placeholder="{{localize 'CPRX.MedscanPerNota'}}" />
    </label>

    <div class="agent-listino">
      {{#each livelli}}
      <div class="agent-listino-voce">
        <div class="agent-listino-testa">
          <span class="agent-listino-nome">{{this.etichetta}}</span>
          <span class="agent-listino-prezzo">
            {{#if this.prezzo}}{{this.prezzo}} eb{{else}}{{localize "CPRX.MedscanGratis"}}{{/if}}
          </span>
        </div>
        <p class="agent-listino-usi">{{this.usi}}</p>
        <div class="agent-listino-piede">
          <span class="agent-etichetta">+{{this.bonus}} · {{this.ore}} h</span>
          <button type="button" class="agent-primario" data-action="medscanRichiedi"
                  data-livello="{{this.chiave}}" {{#if this.troppoCaro}}disabled{{/if}}>
            <i class="fa-solid fa-kit-medical"></i> {{localize "CPRX.MedscanCollega"}}
          </button>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ============================ ZIGGURAT ======================== --}}
  {{#if vistaZiggurat}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
    </header>

    {{!-- Lo sportello unico: si sfoglia per categoria e si cerca. Lo
          compila il master dalla sua console. --}}
    <div class="agent-riga">
      <input type="text" name="ricerca" value="{{ricerca}}"
             placeholder="{{localize 'CPRX.ZigguratCerca'}}" />
      <button type="button" class="agent-solo-icona" data-action="zigguratCerca"
              title="{{localize 'CPRX.Cerca'}}"><i class="fa-solid fa-magnifying-glass"></i></button>
    </div>

    <div class="agent-pacchetti">
      <button type="button" class="agent-linguetta {{#unless filtroAttivo}}attiva{{/unless}}"
              data-action="zigguratCategoria" data-categoria="">
        {{localize "CPRX.TutteLeCategorie"}}
      </button>
      {{#each categorie}}
      <button type="button" class="agent-linguetta {{#if this.attiva}}attiva{{/if}}"
              data-action="zigguratCategoria" data-categoria="{{this.chiave}}">
        {{this.etichetta}} {{#if this.conteggio}}<b>{{this.conteggio}}</b>{{/if}}
      </button>
      {{/each}}
    </div>

    {{#if dbVuoto}}
    <p class="agent-vuoto">{{localize "CPRX.ZigguratDbVuoto"}}</p>
    {{else}}
      {{#if vuoto}}
      <p class="agent-vuoto">{{localize "CPRX.NienteInVetrina"}}</p>
      {{else}}
      <ul class="agent-elenco">
        {{#each voci}}
        <li class="agent-voce-zig">
          <div class="agent-zig-alto">
            <span class="agent-voce-titolo">{{this.nome}}</span>
            <span class="agent-etichetta">{{this.categoria}}</span>
          </div>
          {{#if this.zona}}<span class="agent-voce-sotto">{{this.zona}}</span>{{/if}}
          {{#if this.testo}}<p class="agent-zig-testo">{{this.testo}}</p>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    {{/if}}

    {{#if puoScrivere}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{localize "CPRX.ZigguratCitta"}}</span>
      <span class="agent-filetto"></span>
    </div>
    <div class="agent-riga">
      <input type="text" name="citta" value="{{citta}}" placeholder="Night City" />
      <button type="button" class="agent-solo-icona" data-action="zigguratSalva"
              title="{{localize 'CPRX.Salva'}}"><i class="fa-solid fa-floppy-disk"></i></button>
    </div>

    {{#if attiva}}
    <button type="button" class="agent-primario agent-conferma" data-action="zigguratConsulta">
      <i class="fa-solid fa-city"></i> {{localize "CPRX.ZigguratConsulta"}} (+{{bonus}})
    </button>
    {{/if}}
    {{/if}}
  </div>
  {{/if}}

  {{!-- ============================ VETRINA ========================= --}}
  {{#if vistaNegozio}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="{{iconaApp}}"></i> {{etichettaApp}}</h3>
      {{#if eddiesNoti}}<span class="agent-saldo">{{eddies}} eb</span>{{/if}}
    </header>

    {{!-- La ricerca sta sempre in cima e funziona anche senza aver scelto
          una categoria: prima bisognava aprire un menu per fare qualunque
          cosa. --}}
    <div class="agent-cerca">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="ricerca" value="{{ricerca}}" placeholder="{{localize 'CPRX.Cerca'}}" />
      <button type="button" class="agent-solo-icona" data-action="cerca" title="{{localize 'CPRX.Cerca'}}">
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>

    {{#if eddiesNoti}}
    <div class="agent-pillole">
      <button type="button" class="agent-pillola {{#unless soloAbbordabili}}attiva{{/unless}}"
              data-action="abbordabili" data-tutti="1">{{localize "CPRX.FiltroTutte"}}</button>
      <button type="button" class="agent-pillola {{#if soloAbbordabili}}attiva{{/if}}"
              data-action="abbordabili">{{localize "CPRX.SoloAbbordabili"}}</button>
    </div>
    {{/if}}

    {{#if alBanco}}
    {{!-- Banco: le categorie come mattonelle, non come trenta linguette. --}}
    <div class="agent-banco">
      {{#each categorie}}
      <button type="button" class="agent-reparto" data-action="scegliCategoria" data-tipo="{{this.tipo}}">
        <span class="agent-reparto-nome">{{this.etichetta}}</span>
        <span class="agent-reparto-conta">{{this.conteggio}}</span>
      </button>
      {{/each}}
    </div>
    {{else}}

    {{!-- Briciola: dove sei e come torni indietro. --}}
    <div class="agent-briciola">
      <button type="button" class="agent-briciola-su" data-action="scegliCategoria" data-tipo="">
        <i class="fa-solid fa-chevron-left"></i>
        <span>{{localize "CPRX.TutteLeCategorie"}}</span>
      </button>
      {{#if categoriaAperta}}
      <span class="agent-briciola-qui">{{categoriaAperta}}</span>
      {{/if}}
      {{#if sottoAperta}}
      <button type="button" class="agent-briciola-filtro" data-action="scegliSotto" data-sotto="">
        {{sottoAperta}} <i class="fa-solid fa-xmark"></i>
      </button>
      {{/if}}
    </div>

    {{#if haSotto}}
    <div class="agent-pacchetti agent-sotto">
      {{#each sottocategorie}}
      <button type="button" class="agent-linguetta {{#if this.attiva}}attiva{{/if}}"
              data-action="scegliSotto" data-sotto="{{this.valore}}">{{this.etichetta}} <b>{{this.conteggio}}</b></button>
      {{/each}}
    </div>
    {{/if}}

    {{#if vuoto}}
    <p class="agent-vuoto">{{localize "CPRX.NienteInVetrina"}}</p>
    {{else}}
    <div class="agent-sezione-riga">
      <span class="agent-etichetta">{{quantiMostrati}} / {{totale}}</span>
      <span class="agent-filetto"></span>
    </div>
    {{/if}}

    {{!-- Una riga per articolo dentro una scheda sola: il riquadro
          dell'immagine a sinistra, prezzo e disponibilita' incolonnati a
          destra. La disponibilita' sta sotto il prezzo perche' sono la
          stessa domanda: quanto costa e se lo trovi. --}}
    <ul class="agent-elenco agent-vetrina">
      {{#each articoli}}
      <li class="agent-voce agent-articolo {{#if this.troppoCaro}}caro{{/if}}">
        <span class="agent-articolo-foto">
          {{#if this.immagine}}<img src="{{this.immagine}}" alt="" />{{else}}IMG{{/if}}
        </span>
        <div class="agent-voce-testo">
          <span class="agent-voce-titolo">{{this.nome}}</span>
          <span class="agent-voce-sotto">{{this.etichettaTipo}} · {{this.fonte}}</span>
        </div>
        <span class="agent-articolo-conto">
          <span class="agent-articolo-prezzo">{{this.prezzoTesto}}</span>
          {{#if this.disponibilita}}
          <span class="agent-articolo-scorta">{{this.disponibilita}}</span>
          {{/if}}
        </span>
        {{#if ../puoScrivere}}
        <button type="button" class="agent-solo-icona agent-tondo-piccolo" data-action="compra" data-uuid="{{this.uuid}}"
                title="{{localize 'CPRX.Compra'}}"
                {{#unless this.acquistabile}}disabled{{/unless}}{{#if this.troppoCaro}} disabled{{/if}}>
          <i class="fa-solid fa-cart-plus"></i>
        </button>
        {{/if}}
      </li>
      {{/each}}
    </ul>

    {{#if troncato}}
    <p class="agent-vuoto">{{localize "CPRX.TroppiRisultati"}}</p>
    {{/if}}
    {{/if}}
  </div>
  {{/if}}

  {{!-- ========================= IMPOSTAZIONI ======================= --}}
  {{#if vistaImpostazioni}}
  <div class="agent-schermo">
    <header class="agent-testata">
      <button type="button" class="agent-indietro agent-solo-icona" data-action="home">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <h3><i class="fa-solid fa-gear"></i> {{localize "CPRX.Impostazioni"}}</h3>
    </header>

    {{!-- Chi sei, in cima: e' la prima riga delle impostazioni di qualunque
          telefono, e qui era l'unica schermata dove non c'era. --}}
    <div class="agent-identita-scheda">
      <span class="agent-tondo-iniziali">{{iniziale}}</span>
      <span class="agent-identita-testo">
        <span class="agent-voce-titolo">{{identitaNome}}</span>
        <span class="agent-etichetta">{{identitaRiga}}</span>
      </span>
    </div>

    <h4 class="agent-sezione">{{localize "CPRX.Tema"}}</h4>
    <div class="agent-temi">
      {{#each temi}}
      <button type="button" class="agent-tema macchia-{{this.chiave}} {{#if this.attivo}}attivo{{/if}}"
              data-action="scegliTema" data-tema="{{this.chiave}}">
        <span class="agent-tema-macchia"></span>
        <span class="agent-tema-nome">{{this.etichetta}}</span>
      </button>
      {{/each}}
    </div>

    {{!-- Lo sfondo: una lista chiusa, spedita col modulo. Qui non si carica
          niente — vale ancora la regola per cui dall'Agent nel mondo non
          entrano immagini. --}}
    <h4 class="agent-sezione">{{localize "CPRX.Sfondo"}}</h4>
    <div class="agent-riga-stato">
      <span class="agent-riga-nome">{{localize "CPRX.SfondoNota"}}</span>
      <span class="agent-riga-valore">{{sfondoNome}}</span>
    </div>
    <div class="agent-sfondi">
      {{#each sfondi}}
      <button type="button" class="agent-sfondo-scelta {{#if this.scelto}}scelto{{/if}} {{#unless this.url}}vuoto{{/unless}}"
              data-action="sfondo" data-sfondo="{{this.chiave}}"
              title="{{this.etichetta}}" aria-label="{{this.etichetta}}"
              {{#if this.url}}style="background-image: url('{{this.url}}')"{{/if}}
              {{#unless ../puoScrivere}}disabled{{/unless}}>
        <span class="agent-sfondo-nome">{{this.etichetta}}</span>
        {{#if this.scelto}}<i class="fa-solid fa-check agent-sfondo-spunta"></i>{{/if}}
      </button>
      {{/each}}
    </div>

    <h4 class="agent-sezione">{{localize "CPRX.NumeroAgent"}}</h4>
    <div class="agent-riga">
      <input type="text" value="{{numero}}" readonly />
      {{#if puoScrivere}}
      <button type="button" class="agent-solo-icona" data-action="rigeneraNumero"
              title="{{localize 'CPRX.RigeneraNumero'}}"><i class="fa-solid fa-arrows-rotate"></i></button>
      {{/if}}
    </div>

    <label class="agent-interruttore">
      <input type="checkbox" name="agentInterno" {{#if agentInterno}}checked{{/if}}
             {{#unless puoScrivere}}disabled{{/unless}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.AgentInterno"}}</span>
    </label>

    <label class="agent-interruttore">
      <input type="checkbox" name="gps" {{#if gps}}checked{{/if}}
             {{#unless puoScrivere}}disabled{{/unless}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.TracciamentoGps"}}</span>
    </label>

    <p class="agent-nota">{{localize "CPRX.NumeroNascostoNota"}}</p>

    {{!-- Handle e nome vero. Il saluto usa l'uno o l'altro: non c'e' un
          terzo nome da inventare. --}}
    <h4 class="agent-sezione">{{localize "CPRX.ComeChiamarti"}}</h4>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CampoHandle"}}</span>
      <input type="text" name="handle" value="{{handle}}" placeholder="{{nomeAttore}}"
             {{#unless puoScrivere}}disabled{{/unless}} />
    </label>
    <label class="agent-campo">
      <span class="agent-campo-nome">{{localize "CPRX.CampoNomeVero"}}</span>
      <input type="text" name="nomeVero" value="{{nomeVero}}" placeholder="{{nomeAttore}}"
             {{#unless puoScrivere}}disabled{{/unless}} />
    </label>
    <label class="agent-interruttore">
      <input type="checkbox" name="saluto" {{#unless salutoHandle}}checked{{/unless}}
             {{#unless puoScrivere}}disabled{{/unless}} />
      <span class="agent-leva"></span>
      <span class="agent-interruttore-nome">{{localize "CPRX.SalutoColNome"}}</span>
    </label>

    <h4 class="agent-sezione">{{localize "CPRX.Accento"}}</h4>
    <input type="text" name="accento" value="{{accento}}" placeholder="#00d4a0" />

    <button type="button" class="agent-primario agent-conferma" data-action="salvaPreferenze">
      <i class="fa-solid fa-floppy-disk"></i> {{localize "CPRX.Salva"}}
    </button>

    <button type="button" class="agent-tasto-lungo" data-action="blocca">
      {{localize "CPRX.BloccaDispositivo"}}
    </button>

    {{!-- Il ripristino riporta il telefono alla prima accensione: rifai il
          setup da capo. Non tocca le App comprate ne' i soldi, che stanno
          sulla scheda e non sul dispositivo. --}}
    {{#if puoScrivere}}
    <h4 class="agent-sezione">{{localize "CPRX.Ripristina"}}</h4>
    <p class="agent-nota">{{localize "CPRX.RipristinaNota"}}</p>
    <button type="button" class="agent-tasto-lungo agent-pericolo" data-action="ripristina">
      {{localize "CPRX.RipristinaDispositivo"}}
    </button>
    {{/if}}
  </div>
  {{/if}}

